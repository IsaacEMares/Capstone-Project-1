//@version=6
// Sweep Narrator v2.1 — announces the raw material of the Sweep Reversal
// playbook, honoring the timeframe hierarchy (rules doc v1.1):
//   1m  = trigger: sweep rejection, displacement body, FVG
//   5m  = structure: acceptance, revival, the swings that displacement breaks
//
// Levels tracked automatically:
//   PDH / PDL - previous day high/low (full session daily bar)
//   ONH / ONL - overnight (non-RTH) high/low, frozen at the 8:30 CT open
//   EQH / EQL - equal highs/lows (two 5m pivots within tolerance)
//
// Signals emitted (JSON via alert(), once per bar close):
//   SWEEP_HIGH / SWEEP_LOW - wick through a level with 1m close back inside
//                            within 2 candles (R2.1)
//   LEVEL_ACCEPTED         - 2 consecutive 5m closes beyond a level: fade-side
//                            dead until a 5m close back inside (R2.4)
//   DISPLACEMENT           - 1m body >= mult x avg(10) AND broke the last 5m
//                            swing AND left a 1m FVG (R2.2); extra carries the
//                            gap bounds for the R2.3 entry zone
//
// Run on the MNQ1! ONE-MINUTE chart. Create ONE alert:
// condition "Sweep Narrator (bot)" -> "Any alert() function call", webhook URL.
// Note: 5m-close logic resolves on the 1m bar that completes each 5m bucket,
// so LEVEL_ACCEPTED/revival land ~1 minute after the 5m close. 5m swings use
// 3-bar pivots and confirm with the usual ~15 minute pivot lag.

indicator('Sweep Narrator (bot)', overlay = true)

eqTolTicks = input.int(2, 'Equal high/low tolerance (ticks)', minval = 0)
bodyMult   = input.float(1.5, 'Displacement body multiple (1m)', step = 0.1)
pivotLen   = input.int(3, '5m swing pivot strength (bars each side)', minval = 1)

tol = eqTolTicks * syminfo.mintick

// ---- JSON alert helper ------------------------------------------------------

f_json(_signal, _dir, _extra) =>
    '{"timestamp": "' + str.format_time(timenow, 'yyyy-MM-dd HH:mm:ss', 'UTC') + '", "symbol": "' + syminfo.ticker + '", "timeframe": "' + timeframe.period + '", "indicator": "Sweep_Narrator", "signal": "' + _signal + '", "direction": "' + _dir + '", "price": ' + str.tostring(close) + ', "extra": {' + _extra + '}}'

f_alert(_signal, _dir, _extra) =>
    alert(f_json(_signal, _dir, _extra), alert.freq_once_per_bar_close)

f_lvlExtra(_name, _price) =>
    '"level": "' + _name + '", "level_price": ' + str.tostring(_price)

// ---- session bookkeeping ------------------------------------------------------

inRTH = not na(time(timeframe.period, '0830-1500', 'America/Chicago'))
rthOpenBar = inRTH and not inRTH[1]

// previous day high/low from the daily bar (includes overnight session)
[pdh, pdl] = request.security(syminfo.tickerid, 'D', [high[1], low[1]], lookahead = barmerge.lookahead_on)

// overnight high/low: accumulate while outside RTH, freeze at the open
var float onAccHigh = na
var float onAccLow = na
var float onh = na
var float onl = na
if not inRTH
    onAccHigh := inRTH[1] or na(onAccHigh) ? high : math.max(onAccHigh, high)
    onAccLow := inRTH[1] or na(onAccLow) ? low : math.min(onAccLow, low)
if rthOpenBar
    onh := onAccHigh
    onl := onAccLow

// ---- 5m structure feed ----------------------------------------------------------

// confirmed 5m pivots (the swings displacement must break; EQ detection too)
[ph5, pl5] = request.security(syminfo.tickerid, '5', [ta.pivothigh(pivotLen, pivotLen), ta.pivotlow(pivotLen, pivotLen)], lookahead = barmerge.lookahead_off)

var float swingHigh5 = na
var float swingLow5 = na
var float prevPH5 = na
var float prevPL5 = na

// a new 5m bucket started this bar => close[1] ended the previous 5m candle
fiveClosed = timeframe.change('5')
float close5 = close[1]

// ---- level registry -----------------------------------------------------------
// per level: beyond1 = consecutive 1m closes beyond (sweep rejection machine),
// beyond5 = consecutive 5m closes beyond (acceptance), dead = fade-side dead,
// armed = wick-sweep re-arms only after price trades fully back inside.

var lvlName = array.new_string()
var lvlPrice = array.new_float()
var lvlIsHigh = array.new_bool()
var lvlBeyond1 = array.new_int()
var lvlBeyond5 = array.new_int()
var lvlDead = array.new_bool()
var lvlArmed = array.new_bool()

f_upsert(_name, _price) =>
    idx = array.indexof(lvlName, _name)
    isHigh = str.endswith(_name, 'H')
    if na(_price)
        na
    else if idx == -1
        array.push(lvlName, _name)
        array.push(lvlPrice, _price)
        array.push(lvlIsHigh, isHigh)
        array.push(lvlBeyond1, 0)
        array.push(lvlBeyond5, 0)
        array.push(lvlDead, false)
        array.push(lvlArmed, true)
    else if array.get(lvlPrice, idx) != _price
        array.set(lvlPrice, idx, _price)
        array.set(lvlBeyond1, idx, 0)
        array.set(lvlBeyond5, idx, 0)
        array.set(lvlDead, idx, false)
        array.set(lvlArmed, idx, true)

// refresh the four session levels at each RTH open
if rthOpenBar
    f_upsert('PDH', pdh)
    f_upsert('PDL', pdl)
    f_upsert('ONH', onh)
    f_upsert('ONL', onl)

// equal highs/lows from consecutive 5m pivots within tolerance
if not na(ph5) and ph5 != prevPH5
    if not na(prevPH5) and math.abs(ph5 - prevPH5) <= tol
        f_upsert('EQH', math.max(ph5, prevPH5))
    prevPH5 := ph5
    swingHigh5 := ph5
if not na(pl5) and pl5 != prevPL5
    if not na(prevPL5) and math.abs(pl5 - prevPL5) <= tol
        f_upsert('EQL', math.min(pl5, prevPL5))
    prevPL5 := pl5
    swingLow5 := pl5

// ---- sweep (1m) / acceptance (5m) state machines -------------------------------

if barstate.isconfirmed and array.size(lvlName) > 0
    for i = 0 to array.size(lvlName) - 1
        name = array.get(lvlName, i)
        price = array.get(lvlPrice, i)
        isHigh = array.get(lvlIsHigh, i)

        // ---- 5m layer: acceptance & revival (R2.4)
        if fiveClosed
            beyond5this = isHigh ? close5 > price : close5 < price
            if array.get(lvlDead, i)
                if not beyond5this
                    array.set(lvlDead, i, false)
                    array.set(lvlBeyond5, i, 0)
                    array.set(lvlBeyond1, i, 0)
                    array.set(lvlArmed, i, true)
            else if beyond5this
                b5 = array.get(lvlBeyond5, i) + 1
                array.set(lvlBeyond5, i, b5)
                if b5 >= 2
                    array.set(lvlDead, i, true)
                    f_alert('LEVEL_ACCEPTED', 'neutral', f_lvlExtra(name, price) + ', "side": "' + (isHigh ? 'high' : 'low') + '"')
            else
                array.set(lvlBeyond5, i, 0)

        // ---- 1m layer: sweep rejection (R2.1), suppressed while dead
        if not array.get(lvlDead, i)
            beyond1 = array.get(lvlBeyond1, i)
            armed = array.get(lvlArmed, i)
            wickThrough = isHigh ? high > price : low < price
            closeBeyond = isHigh ? close > price : close < price

            if closeBeyond
                array.set(lvlBeyond1, i, beyond1 + 1)
            else
                if wickThrough and armed
                    f_alert(isHigh ? 'SWEEP_HIGH' : 'SWEEP_LOW', isHigh ? 'short' : 'long', f_lvlExtra(name, price) + ', "rejection": "same_candle"')
                    array.set(lvlArmed, i, false)
                else if beyond1 == 1 and armed
                    f_alert(isHigh ? 'SWEEP_HIGH' : 'SWEEP_LOW', isHigh ? 'short' : 'long', f_lvlExtra(name, price) + ', "rejection": "second_candle"')
                    array.set(lvlArmed, i, false)
                array.set(lvlBeyond1, i, 0)
                if not array.get(lvlArmed, i) and (isHigh ? high < price : low > price)
                    array.set(lvlArmed, i, true)

// ---- displacement (R2.2): 1m body + 1m FVG + 5m swing break --------------------
// Detected one bar after the displacement candle (the FVG needs the next bar).
// Candle under test is bar [1].

avgBody = ta.sma(math.abs(close - open), 10)

if barstate.isconfirmed
    body1 = math.abs(close[1] - open[1])
    violent = body1 >= bodyMult * avgBody[2]
    bullFVG = low > high[2]
    bearFVG = high < low[2]
    if violent and close[1] > open[1] and not na(swingHigh5) and close[1] > swingHigh5 and bullFVG
        f_alert('DISPLACEMENT', 'long', '"fvg_top": ' + str.tostring(low) + ', "fvg_bottom": ' + str.tostring(high[2]) + ', "broke_5m_swing": ' + str.tostring(swingHigh5))
    if violent and close[1] < open[1] and not na(swingLow5) and close[1] < swingLow5 and bearFVG
        f_alert('DISPLACEMENT', 'short', '"fvg_top": ' + str.tostring(low[2]) + ', "fvg_bottom": ' + str.tostring(high) + ', "broke_5m_swing": ' + str.tostring(swingLow5))
