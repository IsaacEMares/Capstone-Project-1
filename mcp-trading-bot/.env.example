# Copy this file to .env and fill in real values. NEVER commit .env.
# Load it before running the server:  set -a; source .env; set +a

# Shared secret embedded in the TradingView webhook URL:
#   https://<your-host>/webhook/<WEBHOOK_SECRET>
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Where the bot server listens (webhook + control + MCP backend API)
BOT_HOST=0.0.0.0
BOT_PORT=8000

# URL the MCP server / botctl CLI use to reach the bot server
BOT_SERVER_URL=http://127.0.0.1:8000

# Simulated paper account
ACCOUNT_START_BALANCE=50000

# Symbols Claude is allowed to trade (comma-separated, everything else is rejected)
SYMBOL_WHITELIST=MES,MNQ

# Hard cap on contracts per order (Phase 3 will formalize full risk profiles)
MAX_POSITION_SIZE=10

# Optional: override $ per point per contract, e.g. "MES=5,MNQ=2,ES=50"
# Defaults cover MES, MNQ, ES, NQ, M2K, MYM.
# SYMBOL_POINT_VALUES=

# Where state/logs are written (default: ./data next to the package)
# BOT_DATA_DIR=
